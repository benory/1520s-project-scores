#!/usr/bin/env bash
# Read validated Sheet CSV through the shared digital-library-build tools.
set -euo pipefail
SCORES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIBRARY_BUILD="${ASSET_TOOL_DIR:-$SCORES_ROOT/../digital-library-build}"
exec "${SHEET_PYTHON:-python3}" "$LIBRARY_BUILD/tools/metadata/score_metadata.py" validate-filenames --project 1520s --scores "$SCORES_ROOT" "$@"
